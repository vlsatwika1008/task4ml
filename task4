import pandas as pd
import matplotlib.pyplot as plt

# Create a dataset using employee details
data = [
    ['E001', 'M', 34, 123, 'Normal', 350],
    ['E002', 'F', 40, 114, 'Overweight', 450],
    ['E003', 'F', 37, 135, 'Obesity', 169],
    ['E004', 'M', 30, 139, 'Underweight', 189],
    ['E005', 'F', 44, 117, 'Underweight', 183],
    ['E006', 'M', 36, 121, 'Normal', 80],
    ['E007', 'M', 32, 133, 'Obesity', 166],
    ['E008', 'F', 26, 140, 'Normal', 120],
    ['E009', 'M', 32, 133, 'Normal', 75],
    ['E010', 'M', 36, 133, 'Underweight', 40]
]

# Convert the dataset into a DataFrame
df = pd.DataFrame(
    data,
    columns=['EMPID', 'Gender', 'Age', 'Sales', 'BMI', 'Income']
)

# Create histogram for numerical columns
print("Histogram")
df.hist()
plt.show()

# Create bar chart for DataFrame
df.plot.bar()
plt.show()

# Create bar chart between Age and Sales
plt.bar(df['Age'], df['Sales'])
plt.xlabel("Age")
plt.ylabel("Sales")
print("Bar chart")
plt.show()

# Create box plot for numerical columns
df.plot.box()
plt.show()

# Create box plot for Income
plt.boxplot(df['Income'])
print("Box Plot chart")
plt.show()

# Create pie chart for Age
plt.pie(
    df['Age'],
    labels=list("ABCDEFGHIJ"),
    autopct='%1.1f%%',
    shadow=True
)
plt.show()

# Create pie chart for Income
plt.pie(
    df['Income'],
    labels=list("ABCDEFGHIJ"),
    autopct='%1.1f%%',
    shadow=True
)
plt.show()

# Create pie chart for Sales
plt.pie(
    df['Sales'],
    labels=list("ABCDEFGHIJ"),
    autopct='%1.1f%%',
    shadow=True
)
plt.show()

# Create scatter plot between Income and Sales
plt.scatter(df['Income'], df['Sales'])
plt.show()

# Create scatter plot between Sales and Age
plt.scatter(df['Sales'], df['Age'])
print("Scatter plot")
plt.show()
